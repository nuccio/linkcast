{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *--admin*)",
      "Bash(gh * --admin*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh workflow run *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh auth token*)",
      "Read(~/.config/claudio4nuccio/**)",
      "Read(**/token.json)",
      "Read(**/client_secrets.json)",
      "Read(**/client_secret*.json)",
      "Read(**/credentials.json)",
      "Read(**/.env)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * refs/heads/main*)",
      "mcp__claude-in-chrome__*",
      "Bash(git push *:**)",
      "Bash(git push * +*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d*)",
      "Bash(gh pr merge *--auto*)",
      "Bash(gh pr merge *--delete-branch*)",
      "Bash(gh pr merge * -d*)",
      "Bash(git push --delete*)",
      "Bash(git push -d*)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/firebase/**)",
      "Read(**/*service-account*.json)",
      "Read(**/application_default_credentials.json)",
      "Bash(gcloud auth print-access-token*)",
      "Bash(gcloud auth print-identity-token*)",
      "Bash(gcloud auth application-default print-access-token*)",
      "Bash(gcloud * deploy*)",
      "Bash(gcloud * create*)",
      "Bash(gcloud * delete*)",
      "Bash(gcloud * update*)",
      "Bash(gcloud * add-iam-policy-binding*)",
      "Bash(gcloud * set-iam-policy*)",
      "Bash(gcloud secrets versions add*)",
      "Bash(firebase deploy*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform state *)"
    ],
    "ask": [
      "Bash(gh release *)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * --method*)",
      "Bash(gh api -f*)",
      "Bash(gh api * -f*)",
      "Bash(gh api -F*)",
      "Bash(gh api * -F*)",
      "Bash(gh api --field*)",
      "Bash(gh api * --field*)",
      "Bash(gh api --raw-field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api --input*)",
      "Bash(gh api * --input*)",
      "Bash(gh api graphql*)",
      "Bash(gh api * graphql*)"
    ]
  }
}
